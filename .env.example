# Only needed to run the app outside Docker (uvicorn app.main:app on the host).
# docker compose sets every one of these inline, so no .env file is required there.
# Environment variables win over this file, so a stray .env cannot override compose.

DATABASE_URL=postgresql+psycopg://pennylane:pennylane@localhost:5432/pennylane

# The tests' own database, created by docker/initdb.sql when the volume is first made.
DATABASE_URL_TEST=postgresql+psycopg://pennylane:pennylane@localhost:5432/pennylane_test

# DEV=1 makes the container entrypoint start uvicorn with --reload.
DEV=0

# SKIP_SEED=1 makes the entrypoint skip the seed entirely. FORCE_SEED=1 makes the
# seed re-run even when conversations already has rows.
SKIP_SEED=0
FORCE_SEED=0
